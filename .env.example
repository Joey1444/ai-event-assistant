# 数据库
# SQLite 文件（相对 prisma/ 目录）
EP_DATABASE_URL="file:./dev.db"

# 文本模型 —— 直连 DeepSeek 官方 API（OpenAI 兼容）
# 去 https://platform.deepseek.com 拿 API Key，填在 EP_AI_API_KEY
EP_AI_BASE_URL=https://api.deepseek.com
EP_AI_API_KEY=
EP_AI_MODEL=deepseek-v4-pro

# 文生图模型 —— 直连 DashScope 原生 API（通义万相）
# baseURL 例：https://maas.qianwenaiapi.com/api/v1（填到 api/v1 为止）
# key 存服务端，不要提交真实 key
EP_IMAGE_API_BASE_URL=
EP_IMAGE_API_KEY=
EP_IMAGE_MODEL=
EP_IMAGE_TIMEOUT_MS=180000

# 联网搜索 —— Researcher Agent 用 Tavily
# 去 https://tavily.com 注册拿 key
EP_TAVILY_API_KEY=

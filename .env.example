# SQLite 数据库文件（相对于 prisma/ 目录）
DATABASE_URL="file:./dev.db"

# AI 网关（CCSwitch）：本项目不直接持有任何模型 Provider 的 Key
# AI_API_KEY 留空即可——真实 Key 由 CCSwitch 持有，这里只是占位
AI_BASE_URL=http://127.0.0.1:15721
AI_API_KEY=
AI_MODEL=deepseek-v4-pro

# 联网调研（Researcher Agent）用 Tavily 搜索
# 去 https://tavily.com 注册拿 key，填在这里（不要提交真实 key）
TAVILY_API_KEY=

# 数据库
# SQLite 文件（相对 prisma/ 目录）
DATABASE_URL="file:./dev.db"

# 文本模型 —— 经 CCSwitch 网关（Anthropic 协议）
# AI_API_KEY 留空即可：真实 Key 由 CCSwitch 持有，这里只是占位
AI_BASE_URL=http://127.0.0.1:15721
AI_API_KEY=
AI_MODEL=deepseek-v4-pro

# 文生图模型 —— 直连 DashScope 原生 API（通义万相，不走 CCSwitch）
# baseURL 例：https://maas.qianwenaiapi.com/api/v1（填到 api/v1 为止）
# key 存服务端，不要提交真实 key
IMAGE_API_BASE_URL=
IMAGE_API_KEY=
IMAGE_MODEL=
IMAGE_TIMEOUT_MS=180000

# 联网搜索 —— Researcher Agent 用 Tavily
# 去 https://tavily.com 注册拿 key
TAVILY_API_KEY=
